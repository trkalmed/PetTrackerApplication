<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomBottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/BottomNavTextActive</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavTextInactive</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@color/surface</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="BottomNavTextActive" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
    </style>
</resources>
