    <string name="detections_today_count">%1$d today</string>
    <!-- The qualifier matters. Detections are produced by the phone's own
         detector, which only runs while the Live screen is open, so the count
         is "what was seen while watching" and not the day's total. Saying
         otherwise would be the app claiming coverage it does not have. -->
    <string name="detections_last_seen">last %1$s · live view only</string>
    <string name="detections_none_while_watching">none yet · live view only</string>
    <string name="detections_camera_not_connected">camera not connected</string>
    <!--
      The tracker's location, and the wording works hard not to be read as the
      pet's. The Raspberry Pi is a box in the hall; its GNSS module locates the
      house. Where the animal is comes from the motion sensors, and this row
      sits beside the camera status precisely because it is device state.
    -->
    <string name="no_gps_fix_yet">Pi has no GPS fix</string>

    <!--
      Feeding on demand. The wording never claims the pet was fed — the feeder
      moves food, and only the load cell knows how much arrived, which comes
      back later as a meal. "Dispensing" and "sent" say what actually happened.
    -->
    <string name="feed_now">Feed now</string>
    <string name="feeder_checking">Checking the feeder…</string>
    <string name="feeder_ready">Ready · the load cell reports what actually lands</string>
