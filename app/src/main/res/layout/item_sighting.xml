<?xml version="1.0" encoding="utf-8"?>
<!--
    One motion sighting: when, where, and what the camera saw.

    The photo is a fixed square rather than the full frame, because a list of
    full-width photos is a list you scroll past rather than read. The time is
    what the eye lands on first — a history is read as a sequence of moments.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sightingCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:cardBackgroundColor="@color/surface_raised"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgSighting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/last_seen_photo"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_pets_24" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSightingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                tools:text="15:20" />

            <TextView
                android:id="@+id/tvSightingRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Kitchen" />

            <!-- Only shown when there is no photo, so the gap is explained
                 rather than looking like a failed download. -->
            <TextView
                android:id="@+id/tvNoPicture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/no_picture_for_this_one"
                android:textColor="@color/text_disabled"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <View
            android:id="@+id/roomDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
