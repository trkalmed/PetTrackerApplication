<?xml version="1.0" encoding="utf-8"?>
<!--
  progressDrawable for barToday / foodProgress / sbSoundVolume.
  Android gradients take three stops, so the four-colour ramp is sampled at
  ramp_1 / ramp_3 / ramp_4 — visually the same sweep.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/divider" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/ramp_1"
                    android:centerColor="@color/ramp_3"
                    android:endColor="@color/ramp_4"
                    android:type="linear" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
