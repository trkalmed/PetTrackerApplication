<?xml version="1.0" encoding="utf-8"?>
<!--
  Display face: pet names, big numbers, card titles.

  As with manrope.xml, the patch expected static bricolage_bold.ttf and
  bricolage_extrabold.ttf; the variable font is what the project has, so both
  weights come from the one file.

  This face carries three axes — opsz, wdth and wght. Only wght is set here;
  opsz is left to its default so the font applies its own optical sizing, which
  is the point of having it.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="800"
        android:fontVariationSettings="'wght' 800" />
</font-family>
