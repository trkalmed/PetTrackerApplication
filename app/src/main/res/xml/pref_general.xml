<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="Account management">

        <Preference
            android:key="account"
            android:title="Account management"
            android:summary="Profile, password, sign out"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="General">

        <SwitchPreferenceCompat
            android:key="sound_enabled"
            android:title="Sound"
            android:summary="Enable app sounds"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:key="sound_volume"
            android:title="Sound volume"
            android:summary="Adjust notification volume"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Other">

        <Preference
            android:key="language"
            android:title="Language"
            android:summary="English"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="storage"
            android:title="Storage"
            android:summary="Cache: calculating..."
            app:iconSpaceReserved="false" />

        <Preference
            android:key="app_info"
            android:title="App info"
            android:summary="Version, licenses, privacy"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="help_feedback"
            android:title="Help feedback"
            android:summary="Report a problem or ask a question"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

</PreferenceScreen>

