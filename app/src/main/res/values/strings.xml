    <string name="feeder_no_pi">No Pi paired. Add one in Settings.</string>
    <string name="feed_dialog_title">How much?</string>
    <string name="feed_dialog_message">Grams to dispense. A paddle feeder turns whole pockets, so it rounds to the nearest one — and what actually falls is whatever the load cell weighs.</string>
