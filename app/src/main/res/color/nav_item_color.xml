<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback tint. The per-tab accent is applied at runtime in
  MainMenuActivity (see README, step 5) because a selector cannot know
  which item is selected — only that something is.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/tab_home" />
    <item android:color="@color/text_secondary" />
</selector>
